{
  "manifestVersion": 2,
  "id": "bot-kanban-board",
  "name": "机器人看板",
  "version": "0.11.0",
  "publisher": "guilatrova",
  "license": "MIT",
  "description": "在同一张看板上查看 Orca 机器人的任务和拉取请求，处理需要你回复的事项，并一键合并。",
  "cover": {
    "path": "assets/cover.png",
    "alt": "机器人看板：查看待我处理、进行中的任务和可合并的拉取请求。"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker/index.ts",
  "engines": { "orca": ">=1.4.274" },
  "contributes": {
    "customEditors": [
      {
        "id": "board",
        "title": "机器人看板",
        "extensions": [".botkanban"],
        "entry": "editor/board.html",
        "frame": "isolated"
      }
    ],
    "commands": [
      { "id": "bot-kanban-board.open", "title": "打开机器人看板" },
      { "id": "bot-kanban-board.needs-you", "title": "查看待我处理的任务" }
    ],
    "statusBarItems": [
      { "id": "needs-you", "text": "待我处理…", "icon": "bell", "command": "bot-kanban-board.needs-you" }
    ],
    "events": [{ "on": "agent.status.changed" }],
    "settings": [
      { "key": "demo", "type": "boolean", "default": false, "title": "演示数据（重启插件后生效）" },
      { "key": "orcaPath", "type": "string", "default": "", "title": "Orca 可执行文件路径" },
      { "key": "ghPath", "type": "string", "default": "", "title": "GitHub CLI 可执行文件路径" },
      {
        "key": "itemsSeconds",
        "type": "integer",
        "default": 30,
        "title": "任务刷新间隔（秒）",
        "minimum": 10,
        "maximum": 3600
      },
      {
        "key": "prSeconds",
        "type": "integer",
        "default": 90,
        "title": "拉取请求刷新间隔（秒）",
        "minimum": 10,
        "maximum": 3600
      }
    ]
  },
  "capabilities": [
    { "kind": "notifications:show" },
    { "kind": "storage:own" },
    { "kind": "settings:own" },
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:read" }
  ]
}
